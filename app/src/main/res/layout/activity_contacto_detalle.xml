<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ContactoDetalleActivity">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_contact_detail"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:textSize="25sp"
        android:textStyle="bold"
        />

    <!-- Nombre -->
    <TextView
        android:id="@+id/nameLabel"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        app:layout_constraintBaseline_toBaselineOf="@+id/name"
        app:layout_constraintStart_toStartOf="parent"
        android:text="@string/name"
        />
    <TextView
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/name_example"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_constraintStart_toEndOf="@id/nameLabel"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp"
        />

    <!-- Telefono -->
    <TextView
        android:id="@+id/phoneLabel"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        app:layout_constraintBaseline_toBaselineOf="@+id/phone"
        app:layout_constraintStart_toStartOf="parent"
        android:text="@string/phone"
        />
    <TextView
        android:id="@+id/phone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/name_example"
        app:layout_constraintTop_toBottomOf="@+id/nameLabel"
        app:layout_constraintStart_toEndOf="@id/phoneLabel"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"
        />

    <!-- Email -->
    <TextView
        android:id="@+id/emailLabel"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        app:layout_constraintBaseline_toBaselineOf="@+id/email"
        app:layout_constraintStart_toStartOf="parent"
        android:text="@string/emailDetail"
        />
    <TextView
        android:id="@+id/email"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/name_example"
        app:layout_constraintTop_toBottomOf="@+id/phoneLabel"
        app:layout_constraintStart_toEndOf="@id/emailLabel"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"
        />

    <!-- Categoria -->
    <TextView
        android:id="@+id/categoryLabel"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        app:layout_constraintBaseline_toBaselineOf="@+id/category"
        app:layout_constraintStart_toStartOf="parent"
        android:text="@string/cagegory"
        />
    <TextView
        android:id="@+id/category"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/name_example"
        app:layout_constraintTop_toBottomOf="@+id/emailLabel"
        app:layout_constraintStart_toEndOf="@id/emailLabel"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"
        />

    <!-- Notas -->
    <TextView
        android:id="@+id/noteLabel"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/category"
        app:layout_constraintStart_toStartOf="parent"
        android:text="@string/notes"
        android:layout_marginTop="10dp"
        />
    <TextView
        android:id="@+id/notes"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:hint="@string/name_example"
        app:layout_constraintTop_toBottomOf="@+id/noteLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"
        />

    <!-- Botones -->
    <Button
        android:id="@+id/btnCall"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="Llamar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnEmail"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintBaseline_toBaselineOf="@+id/btnEmail"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="40dp"
        android:backgroundTint="@color/green_blue"
        />
    <Button
        android:id="@+id/btnEmail"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="Email"
        app:layout_constraintStart_toEndOf="@id/btnCall"
        app:layout_constraintTop_toBottomOf="@+id/notes"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="8dp"
        android:backgroundTint="@color/blue"
        android:layout_marginTop="40dp"

        />
    <Button
        android:id="@+id/btnEdit"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="Editar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintBaseline_toBaselineOf="@+id/btnDelete"
        app:layout_constraintEnd_toStartOf="@+id/btnDelete"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="40dp"
        android:backgroundTint="@color/orange"
        />
    <Button
        android:id="@+id/btnDelete"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="Eliminar"
        app:layout_constraintStart_toEndOf="@+id/btnEdit"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="8dp"
        android:backgroundTint="@color/red"
        app:layout_constraintTop_toBottomOf="@+id/btnCall"
        android:layout_marginTop="40dp"

        />

</androidx.constraintlayout.widget.ConstraintLayout>